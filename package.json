{
  "name": "content-pipeline",
  "version": "0.6.0",
  "private": true,
  "description": "Turn a launch announcement into ready-to-post social content: copy, an image card, a voiceover spec, and video render specs.",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "smoke:copy": "tsx smoke/copy-smoke.ts",
    "smoke:image": "tsx smoke/image-smoke.ts",
    "smoke:video": "tsx smoke/video-smoke.ts",
    "smoke:voice": "tsx smoke/voice-smoke.ts",
    "smoke:caption-sync-real": "tsx smoke/caption-sync-real.ts",
    "smoke:genart": "tsx smoke/genart-smoke.ts",
    "smoke:launch-card": "tsx smoke/launch-card.ts",
    "smoke:launch-card:paid": "LAUNCH_CARD_PAID=1 tsx smoke/launch-card.ts",
    "smoke:launch-card-post2": "tsx smoke/launch-card-post2.ts",
    "smoke:demo": "tsx smoke/demo-video.ts",
    "smoke:demo-narrated": "tsx smoke/demo-narrated.ts",
    "smoke:demo-narrated:paid": "DEMO_NARRATED_PAID=1 tsx smoke/demo-narrated.ts",
    "smoke:demo-multi": "tsx smoke/demo-multi-aspect.ts",
    "smoke:builder-demo-narrated": "tsx smoke/builder-demo-narrated.ts",
    "smoke:builder-demo-narrated:paid": "BUILDER_DEMO_PAID=1 tsx smoke/builder-demo-narrated.ts",
    "smoke:builder-demo-multi": "tsx smoke/builder-demo-multi-aspect.ts",
    "smoke:publish-typefully": "tsx smoke/publish-typefully.ts",
    "smoke:publish-typefully:live": "TYPEFULLY_LIVE=1 tsx smoke/publish-typefully.ts",
    "e2e:lfah": "tsx smoke/e2e-lfah.ts"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.474",
    "@remotion/renderer": "^4.0.474",
    "playwright": "^1.60.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.474"
  }
}
